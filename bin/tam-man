#!/bin/sh
# tam-man - lightweight man wrapper opening hyperlinked manual pages via tam
set -eu

if [ $# -eq 0 ]; then
    man
    exit $?
fi

# Locate tam binary: prefer adjacent binary, build binary, or PATH
tam_bin=""
if [ -x "$(dirname "$0")/tam" ]; then
    tam_bin="$(dirname "$0")/tam"
elif [ -x "$(dirname "$0")/../build/tam" ]; then
    tam_bin="$(dirname "$0")/../build/tam"
elif command -v tam >/dev/null 2>&1; then
    tam_bin="tam"
fi

if [ -n "$tam_bin" ]; then
    exec "$tam_bin" man "$@"
fi

# Fallback to standard man if tam is unavailable
exec man "$@"
