# Bash completion for tam(1)
# Static completion: subcommands and fixed flags only. Zero file I/O.

_tam_completions() {
    local cur prev
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"

    local subcommands="show welcome explain search man install ask help"
    local global_flags="--help -h --version -V"

    if [ "$COMP_CWORD" -eq 1 ]; then
        if [[ "$cur" == -* ]]; then
            COMPREPLY=($(compgen -W "$global_flags" -- "$cur"))
        else
            COMPREPLY=($(compgen -W "$subcommands $global_flags" -- "$cur"))
        fi
        return 0
    fi

    local cmd="${COMP_WORDS[1]}"
    case "$cmd" in
        install)
            if [ "$COMP_CWORD" -eq 2 ]; then
                COMPREPLY=($(compgen -W "inspect check plan apply verify --help" -- "$cur"))
            elif [ "${COMP_WORDS[2]}" = "inspect" ]; then
                if [ "$prev" = "--check" ]; then
                    COMPREPLY=($(compgen -W "storage_root_space storage_btrfs privilege_pkexec init_systemd graphics_card package_manager kernel_release" -- "$cur"))
                else
                    COMPREPLY=($(compgen -W "--pipe --json --check" -- "$cur"))
                fi
            elif [ "${COMP_WORDS[2]}" = "check" ]; then
                COMPREPLY=($(compgen -W "storage_root_space storage_btrfs privilege_pkexec init_systemd graphics_card package_manager kernel_release --json --help" -- "$cur"))
            fi
            ;;
        search)
            COMPREPLY=($(compgen -W "--json --pipe" -- "$cur"))
            ;;
        show|welcome)
            COMPREPLY=($(compgen -W "--pipe" -- "$cur"))
            ;;
        explain)
            if [ "$prev" = "--level" ]; then
                COMPREPLY=($(compgen -W "beginner intermediate expert" -- "$cur"))
            else
                COMPREPLY=($(compgen -W "--pipe --level" -- "$cur"))
            fi
            ;;
        man)
            COMPREPLY=($(compgen -W "--help --pipe" -- "$cur"))
            ;;
        ask)
            if [ "$prev" = "--model" ] || [ "$prev" = "--server" ]; then
                COMPREPLY=()
            else
                COMPREPLY=($(compgen -W "--model --server --json --pipe --help -h" -- "$cur"))
            fi
            ;;
        *)
            ;;
    esac
}

complete -F _tam_completions tam
