# Bash completion for tam(1)
# Static completion: subcommands and fixed flags only. Zero file I/O.

_tam_completions() {
    local cur prev
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"

    local subcommands="show welcome hello hi explain search man info tldr inspect check install ask upgrade switch help"
    local global_flags="--help -h --pipe --terse --verbose --version -v -V"

    if [ "$COMP_CWORD" -eq 1 ]; then
        if [[ "$cur" == -* ]]; then
            COMPREPLY=($(compgen -W "$global_flags" -- "$cur"))
        else
            COMPREPLY=($(compgen -W "$subcommands $global_flags" -- "$cur"))
        fi
        return 0
    fi

    local cmd="${COMP_WORDS[1]}"
    case "$cmd" in
        inspect)
            if [ "$prev" = "--check" ]; then
                COMPREPLY=($(compgen -W "storage_root_space storage_btrfs privilege_pkexec init_systemd graphics_card package_manager kernel_release" -- "$cur"))
            else
                COMPREPLY=($(compgen -W "--pipe --json --check --terse --help -h" -- "$cur"))
            fi
            ;;
        check)
            COMPREPLY=($(compgen -W "storage_root_space storage_btrfs privilege_pkexec init_systemd graphics_card package_manager kernel_release --json --terse --help -h" -- "$cur"))
            ;;
        install)
            COMPREPLY=($(compgen -W "plan apply verify --help -h" -- "$cur"))
            ;;
        search)
            COMPREPLY=($(compgen -W "--json --pipe --help" -- "$cur"))
            ;;
        show)
            if [ "$prev" = "--level" ]; then
                COMPREPLY=($(compgen -W "all beginner intermediate expert 0 1 2 3" -- "$cur"))
            else
                COMPREPLY=($(compgen -W "tam:search tam:man tam:tldr --pipe --level" -- "$cur"))
            fi
            ;;
        welcome|hello|hi)
            COMPREPLY=($(compgen -W "--pipe" -- "$cur"))
            ;;
        explain)
            if [ "$prev" = "--level" ]; then
                COMPREPLY=($(compgen -W "all beginner intermediate expert 0 1 2 3" -- "$cur"))
            else
                COMPREPLY=($(compgen -W "topics --pipe --level --terse --verbose" -- "$cur"))
            fi
            ;;
        man)
            COMPREPLY=($(compgen -W "printf grep ls cat bash systemctl fstab 1 3 5 --help --pipe" -- "$cur"))
            ;;
        info)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--help -h --pipe" -- "$cur"))
            else
                COMPREPLY=($(compgen -W "bash coreutils libc make gcc gdb grep sed tar find diffutils gzip readline binutils bison flex autoconf automake cpio as ld cpp gnupg gnutls --help -h --pipe" -- "$cur"))
            fi
            ;;
        tldr)
            if [ "$prev" = "--platform" ] || [ "$prev" = "-L" ]; then
                COMPREPLY=($(compgen -W "linux common" -- "$cur"))
            elif [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--list -l --search --keyword --platform --pipe --help -h" -- "$cur"))
            else
                COMPREPLY=($(compgen -W "tar grep find git systemctl pacman btrfs hyprctl curl ssh --list --search --platform --pipe --help -h" -- "$cur"))
            fi
            ;;
        ask)
            if [ "$prev" = "--model" ] || [ "$prev" = "--server" ]; then
                COMPREPLY=()
            else
                COMPREPLY=($(compgen -W "--model --server --json --pipe --help -h" -- "$cur"))
            fi
            ;;
        upgrade)
            case "$prev" in
                --channel) COMPREPLY=($(compgen -W "development develop test run release" -- "$cur")) ;;
                *) COMPREPLY=($(compgen -W "--check --apply --channel --json --help -h" -- "$cur")) ;;
            esac
            ;;
        switch)
            case "$prev" in
                --version|--corpus-version) COMPREPLY=() ;;
                *) COMPREPLY=($(compgen -W "development develop test run release --rollback --version --corpus-version --help -h" -- "$cur")) ;;
            esac
            ;;
        *)
            ;;
    esac
}

complete -F _tam_completions tam tam-man tam-info tam-tldr
