#compdef tam

# Zsh completion for tam(1)
# Static completion: subcommands and fixed flags only. Zero file I/O.

_tam() {
    local -a subcommands
    subcommands=(
        'show:Open offline guide in pager or text'
        'welcome:First-run orientation'
        'explain:Curated topic explainer'
        'search:Search corpus index'
        'man:Native manual page viewer'
        'install:Installation inspection and framework'
        'help:Display usage help'
    )

    local -a global_flags
    global_flags=(
        '(-h --help)'{-h,--help}'[Show usage information]'
        '(-V --version)'{-V,--version}'[Show version information]'
    )

    if (( CURRENT == 2 )); then
        _arguments -s \
            $global_flags \
            '1:subcommand:->subcmd' && return 0
        if [[ $state == subcmd ]]; then
            _describe -t subcommands 'tam subcommands' subcommands
            return 0
        fi
    fi

    case $words[2] in
        install)
            if (( CURRENT == 3 )); then
                local -a install_cmds
                install_cmds=(
                    'inspect:Read-only host inspection'
                    'plan:Installation plan'
                    'apply:Apply installation'
                    'verify:Verify installation'
                    '--help:Show install usage'
                )
                _describe -t install_cmds 'install commands' install_cmds
            elif (( CURRENT == 4 )) && [[ $words[3] == "inspect" ]]; then
                _arguments '--pipe[Emit plain text without terminal controls]'
            fi
            ;;
        search)
            _arguments \
                '--json[Emit machine-readable JSON output]' \
                '--pipe[Emit plain text without terminal controls]'
            ;;
        show|welcome|explain)
            _arguments '--pipe[Emit plain text without terminal controls]'
            ;;
        man)
            _arguments \
                '--help[Show man usage]' \
                '--pipe[Emit plain text without terminal controls]'
            ;;
    esac
}

_tam "$@"
